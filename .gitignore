# ========================================================
# GitIgnore - Salón de Belleza AREMI
# Excluye binarios, bases de datos locales y configuraciones
# ========================================================

# Binarios y clases compiladas
*.class
**/*.class
out/
**/out/
bin/
**/bin/

# Base de datos local H2 y locks
*.mv.db
**/*.mv.db
*.trace.db
**/*.trace.db
salon_aremi_db*

# Archivo de propiedades con credenciales locales
db.properties
**/db.properties
db_config.properties
**/db_config.properties

# Archivos temporales de compilación y logs
sources.txt
**/sources.txt
hs_err_pid*.log
replay_pid*.log
*.log

# Archivos de IDE (IntelliJ IDEA, Eclipse, VS Code)
.idea/
**/.idea/
*.iml
**/*.iml
.vscode/
**/.vscode/
.settings/
.classpath
.project

# Archivos del Sistema Operativo
Thumbs.db
.DS_Store

*.docx
generar_*.py
*.html
DOCUMENTO_*.md
GUIA_*.md

